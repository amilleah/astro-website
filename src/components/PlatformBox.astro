---
import { Icon } from "astro-icon/components";
import "../styles/platform-box.css";

interface PlatformBoxData {
  platform: string;
  icon: any;
  url: string;
  subtitle?: string;
  additionalUrls: Array<{ url: string; text: string }>;
}

interface Props {
  platformBoxData: PlatformBoxData;
}

const platformBoxData = Astro.props.platformBoxData;
---

<div class="platformBox">
  <div class="platformHeader">
    <Icon
      width="1.25em"
      height="1.25em"
      class="inline-block"
      name={platformBoxData.icon}
    />{" "}
    {platformBoxData.platform}
  </div>
  <div class="platformDownload">
    <a
      href={platformBoxData.url}
      target="_blank"
      rel="noreferrer"
      class="downloadButton">Download</a
    >
    {
      platformBoxData.additionalUrls.map((additionalUrl) => (
        <a
          href={additionalUrl.url}
          target="_blank"
          rel="noreferrer"
          class="altDownload"
        >
          {additionalUrl.text}
        </a>
      ))
    }
    {
      platformBoxData.subtitle && (
        <span class="subtitle">{platformBoxData.subtitle}</span>
      )
    }
  </div>
</div>

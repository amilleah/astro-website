---
import { Icon } from "astro-icon/components";
import "../styles/platform-box.css";

interface AdditionalUrl {
  url: string;
  text: string;
}

interface PlatformBoxData {
  platform: string;
  icon: string;
  url: string;
  subtitle?: string;
  additionalUrls: AdditionalUrl[];
}

interface Props {
  platformBoxData: PlatformBoxData;
}

const { platform, icon, url, subtitle, additionalUrls } =
  Astro.props.platformBoxData;
---

<div class="platformBox">
  <div class="platformHeader">
    <Icon width="1.25em" height="1.25em" name={icon} />
    {platform}
  </div>

  <div class="platformDownload">
    <a href={url} target="_blank" rel="noreferrer" class="downloadButton">
      Download
    </a>

    {
      additionalUrls.map(({ url: altUrl, text }) => (
        <a href={altUrl} target="_blank" rel="noreferrer" class="altDownload">
          {text}
        </a>
      ))
    }

    {subtitle && <span class="subtitle">{subtitle}</span>}
  </div>
</div>

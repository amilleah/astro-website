---
import normal from "../assets/generated_buttons/general_normal.png?url";
import hovered from "../assets/generated_buttons/general_hovered.png?url";

interface Props {
  href?: string;
  class?: string;
  size?: "sm" | "md" | "lg";
  [key: string]: any;
}

const { href, class: className, size = "md", ...rest } = Astro.props;
const Tag = href ? "a" : "button";
const vars = `--btn-normal:url(${normal});--btn-hovered:url(${hovered});`;
---

<Tag
  href={href}
  class:list={["btn", `btn--${size}`, className]}
  style={vars}
  {...rest}
>
  <span class="btn__label"><slot /></span>
</Tag>

<style>
  .btn {
    border-style: solid;
    border-width: 20px;
    border-image-source: var(--btn-normal);
    border-image-slice: 9 fill;
    border-image-repeat: round;
    image-rendering: pixelated;

    box-sizing: border-box;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 0;
    max-width: 100%;
    line-height: 1;
    background: transparent;
    cursor: pointer;
    text-decoration: none;
    transition:
      transform 0.12s ease,
      filter 0.12s ease;
  }

  .btn:hover {
    border-image-source: var(--btn-hovered);
  }

  .btn:active {
    transform: translateY(1px);
    filter: brightness(0.96);
  }

  .btn__label {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4em;
    padding-bottom: 2px;
    max-width: 100%;
    color: var(--color-text);
    font-family: var(--font-clangen), sans-serif;
    line-height: 1;
    text-align: center;
    text-wrap: balance;
    overflow-wrap: anywhere;
  }

  .btn--sm {
    padding-inline: var(--space-xs);
  }

  .btn--sm .btn__label {
    font-size: var(--pixel-sm);
  }

  .btn--md {
    padding-inline: var(--space-sm);
  }

  .btn--md .btn__label {
    font-size: var(--pixel-md);
  }

  .btn--lg {
    padding-inline: var(--space-md);
    min-width: min(11rem, 100%);
  }

  .btn--lg .btn__label {
    font-size: var(--pixel-lg);
  }
</style>

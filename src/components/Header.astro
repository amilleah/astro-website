---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import Button from "./Button.astro";
import Frame from "./Frame.astro";
import defaultHeaderImage from "../assets/header_amalgam.png";

interface Props {
  image?: ImageMetadata;
  alt?: string;
  title?: string;
  subtitle?: string;
}

const { image = defaultHeaderImage, alt = "", title, subtitle } = Astro.props;
---

<article class="hero">
  <div class="header-wrap">
    <div class="header">
      <Image src={image} alt={alt} />
      <slot name="overlay" />
    </div>
  </div>

  <Frame class="header-frame" variant="header">
    <slot>
      {title && <h2>{title}</h2>}
      {subtitle && <h3>{subtitle}</h3>}
      <slot name="action">
        <Button href="/download" size="lg">Download Now</Button>
      </slot>
    </slot>
  </Frame>
</article>

<style>
  @reference "tailwindcss";

  .hero {
    width: 100%;
    max-width: 100%;
    margin-inline: auto;
    padding-top: var(--header-offset);
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
  }

  .header-wrap {
    width: calc(100% - var(--frame-width) * 0.78);
    margin-inline: auto;
    position: relative;
    z-index: 3;
    line-height: 0;
  }

  .header {
    width: 100%;
    position: relative;
    z-index: 3;
    display: block;
    overflow: hidden;
  }

  .header img {
    position: relative;
    width: 100%;
    max-width: 100%;
    height: auto;
    display: block;
    pointer-events: none;
    image-rendering: pixelated;
    filter: drop-shadow(0 6px 10px rgba(0, 0, 0, 0.35));
  }

  :global(.frame.header-frame) {
    --frame-image: var(--frame-header-image);
    --frame-overlap: calc(var(--frame-width) * 1.5);
    width: 100%;
    position: relative;
    z-index: 2;
  }

  :global(.header-frame.header .content) {
    width: 100%;
    position: relative;
    z-index: 2;
    gap: calc(var(--space) * 3);
    padding-top: calc(var(--space) * 2);
    padding-bottom: var(--space);
    padding-left: var(--space);
    padding-right: var(--space);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  :global(.header-frame .content) h2 {
    font-size: var(--header-title-size, var(--pixel-hero));
    line-height: normal;
    font-family: var(--font-clangen), sans-serif;
    text-shadow: 4px 8px 4px rgba(0, 0, 0, 0.75);
    font-weight: 400;
    color: var(--color-text);
  }

  h3 {
    color: var(--color-heading);
    font-family: var(--font-clangen), sans-serif;
    font-size: var(--text-xl);
    line-height: 1;
    font-weight: 500;
    margin-top: calc(var(--space) * -1.5);
    margin-bottom: calc(var(--space) * -1.5);
  }
</style>

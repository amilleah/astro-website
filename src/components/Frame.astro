---
interface Props {
  class?: string;
  variant?: "default" | "header";
}

const {
  class: className = "",
  variant = "default",
} = Astro.props;
---

<div class={`frame ${variant} ${className}`}>
  <div class="content">
    <slot />
  </div>
</div>

<style>
  .frame {
    box-sizing: border-box;
    width: 100%;
    max-width: var(--frame-max-width, 100%);
    margin-inline: auto;

    border-style: solid;
    border-width: var(--frame-width);

    border-image-source: var(--frame-image);
    border-image-slice: 10 fill;
    border-image-width: var(--frame-width);
    border-image-repeat: repeat;

    filter: drop-shadow(0 6px 10px rgba(0, 0, 0, 0.35));
  }

  .frame.header {
    --frame-image: var(--frame-header-image);
    margin-top: calc(var(--frame-width) * -1);
  }

  .content {
    width: 100%;
    height: 100%;
    box-sizing: border-box;

    background-color: var(--color-surface);

    display: flex;
    flex-direction: column;
    gap: calc(var(--space, 1rem) * 0.75);

    padding: var(--card-pad, clamp(1.25rem, 4cqi, 2.25rem));
  }
</style>
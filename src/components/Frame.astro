---
interface Props {
  class?: string;
  variant?: "default" | "header";
}

const { class: className = "", variant = "default" } = Astro.props;
---

<div class:list={["frame", variant, className]}>
  <div class="content">
    <slot />
  </div>
</div>

<style>
  .frame {
    box-sizing: border-box;
    width: 100%;
    max-width: var(--frame-max-width, 100%);
    margin-inline: auto;

    border-style: solid;
    border-width: var(--frame-width);

    border-image-source: var(--frame-image);
    border-image-slice: 10 fill;
    border-image-width: var(--frame-width);
    border-image-repeat: repeat;
  }

  .frame.header {
    --frame-image: var(--frame-header-image);
    margin-top: calc(-1 * var(--frame-overlap, var(--frame-width)));
  }

  .content {
    box-sizing: border-box;
    width: 100%;
    height: 100%;

    display: flex;
    flex-direction: column;
    gap: calc(var(--space) * 0.75);

    padding: var(--card-pad);
    background-color: var(--color-surface);
    box-shadow: var(--shadow-image);
  }
</style>

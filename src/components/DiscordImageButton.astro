---
import discord_btn from "../assets/discord_btn.png";
import { discord_link_store } from "../constants";
---

<a
  href={discord_link_store}
  target="_blank"
  rel="noreferrer"
  class="discord-btn"
>
  <img src={discord_btn.src} alt="Join us on Discord" />
</a>

<style>
  .discord-btn {
    display: flex;
    align-items: center;
    text-decoration: none;
  }

  .discord-btn img {
    height: 2.5rem;
    width: auto;
    margin: auto;
  }
</style>

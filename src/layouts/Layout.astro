---
import "../styles/global.css";
import icon from "../assets/icon.png";
import { Icon } from "astro-icon/components";
import { Font } from "astro:assets";

import { discord_link_store } from "../constants";
import DiscordImageButton from "../components/DiscordImageButton.astro";
import Button from "../components/Button.astro";

const { title = "ClanGen" } = Astro.props;

const navLinks = [
  {
    href: "https://clangen.io/docs/",
    label: "Documentation",
    external: true,
  },
  { href: "/download", label: "Download", external: false },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/icon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <Font preload cssVariable="--font-clangen" />
    <Font cssVariable="--font-roboto" />
  </head>
  <body>
    <div class="container_internal">
      <nav class="navbar">
        <a class="navbar__title" href="/">
          <img
            width={icon.width}
            height={icon.height}
            src={icon.src}
            alt="icon"
          />
          <h1>ClanGen</h1>
        </a>

        <div class="navbar__links">
          {
            navLinks.map(({ href, label, external }) => (
              <Button
                href={href}
                size="sm"
                target={external ? "_blank" : undefined}
                rel={external ? "noreferrer" : undefined}
              >
                {label}
              </Button>
            ))
          }
          <DiscordImageButton />
        </div>

        <button
          id="hamburger-button"
          class="navbar__hamburger"
          type="button"
          aria-controls="mobile-nav"
          aria-expanded="false"
          aria-label="Toggle navigation"
        >
          <Icon width="2em" height="2em" name="fa7-solid:bars" />
        </button>
      </nav>

      <div id="mobile-nav" class="mobile-nav">
        {
          navLinks.map(({ href, label, external }) => (
            <div class="mobile-nav__item">
              <Button
                href={href}
                size="sm"
                target={external ? "_blank" : undefined}
                rel={external ? "noreferrer" : undefined}
              >
                {label}
              </Button>
            </div>
          ))
        }
        <div class="mobile-nav__item">
          <Button href={discord_link_store} size="sm">Discord</Button>
        </div>
      </div>

      <slot />
    </div>
  </body>
</html>

<script>
  import { getCurrentSeason } from "../lib/postlight/seasons";

  const mobileNav = document.getElementById("mobile-nav");
  const hamburger = document.getElementById("hamburger-button");
  const rootElement = document.querySelector<HTMLElement>(":root");

  hamburger?.addEventListener("click", () => {
    const open = mobileNav?.classList.toggle("is-open") ?? false;
    hamburger.setAttribute("aria-expanded", String(open));
  });

  const seasonByHumanSeason: Record<string, string> = {
    spring: "newleaf",
    summer: "greenleaf",
    fall: "leaffall",
    winter: "leafbare",
  };

  const campTypes = ["beach", "forest", "mountainous", "plains"];
  const campType = campTypes[Math.floor(Math.random() * campTypes.length)];
  const campNumber = Math.floor(Math.random() * 3) + 1;
  const season = seasonByHumanSeason[getCurrentSeason(new Date())] ?? "newleaf";

  rootElement?.style.setProperty(
    "--background-url",
    `url("/backgrounds/${campType}/${season}_camp${campNumber}_light.png")`,
  );
</script>

<style>
  :global(html),
  :global(body) {
    padding: 0;
    margin: 0;
    color: var(--color-text);
    background-color: var(--color-bg);
    font-family: var(--font-roboto), sans-serif;
  }

  :global(body) {
    display: flex;
    min-height: 100vh;
    background-image: var(--background-url);
    background-repeat: no-repeat;
    background-size: cover;
    background-attachment: fixed;
    image-rendering: pixelated;
  }

  .container_internal {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    width: 100%;
    backdrop-filter: blur(8px);
  }

  .navbar {
    position: sticky;
    top: 0;
    z-index: var(--z-nav);
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    padding: var(--space-xs) var(--space-2xs);
    background-color: var(--color-bg);
    box-shadow: var(--shadow-sm);
    box-sizing: border-box;
  }

  .navbar a {
    display: flex;
    text-decoration: none;
  }

  .navbar__title {
    align-items: center;
    height: fit-content;
  }

  .navbar__title img {
    height: 2.25rem;
    width: auto;
    margin-right: var(--space-xs);
  }

  .navbar__title h1 {
    margin: 0;
    color: var(--color-text);
    font-family: var(--font-clangen), sans-serif;
    font-size: var(--text-lg);
    font-weight: 700;
    text-shadow: var(--shadow-text-sm);
  }

  .navbar__links {
    display: none;
    align-items: center;
    gap: var(--space-xs);
    margin-left: auto;
  }

  .navbar__hamburger {
    margin-left: auto;
    padding: var(--space-xs) var(--space-xs) 0 0;
    border: none;
    background: transparent;
    color: inherit;
    cursor: pointer;
  }

  .mobile-nav {
    display: none;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--space-lg);
    padding: var(--space-sm) var(--space-xs);
    border-right: var(--space-xs) solid var(--color-border-soft);
  }

  .mobile-nav.is-open {
    display: flex;
  }

  .mobile-nav__item {
    width: fit-content;
  }

  @media (width >= 40rem) {
    .navbar {
      padding-inline: var(--space-xs);
    }

    .navbar__links {
      display: flex;
    }

    .navbar__hamburger,
    .mobile-nav,
    .mobile-nav.is-open {
      display: none;
    }
  }

  @media (width >= 64rem) {
    .navbar {
      padding-inline: var(--space-sm);
    }
  }
</style>

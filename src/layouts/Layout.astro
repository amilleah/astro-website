---
import "../styles/global.css";
import icon from "../assets/icon.png";
import { Icon } from "astro-icon/components";
import { Font } from "astro:assets";

import { discord_link_store } from "../constants";
import DiscordImageButton from "../components/DiscordImageButton.astro";

const { title = "ClanGen", linkToDevelopment = false } = Astro.props;
const downloadBaseUrl = ".";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/icon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <Font preload cssVariable="--font-clangen" />
    <Font cssVariable="--font-roboto" />
  </head>
  <body>
    <div class="container_internal">
      <div class="navbar">
        <a class="navbar__title" href="/">
          <img
            width={icon.width}
            height={icon.height}
            src={icon.src}
            alt="icon"
          />
          <h1>ClanGen</h1>
        </a>
        <div class="navbar__links">
          <a
            href="https://clangen.io/docs/"
            class="small_download_btn"
            target="_blank"
            rel="noreferrer">Documentation</a
          >
          {
            linkToDevelopment ? (
              <a
                href={downloadBaseUrl + "/download-development"}
                class="small_download_btn whitespace-nowrap"
              >
                Download development
              </a>
            ) : (
              <a
                href={downloadBaseUrl + "/download"}
                class="small_download_btn"
              >
                Download
              </a>
            )
          }
          <DiscordImageButton />
        </div>

        <div class="navbar__hamburger">
          <button
            id="hamburger-button"
            onclick="() => (navVisible = !navVisible)"
          >
            <Icon width="2em" height="2em" name="fa7-solid:bars" />
          </button>
        </div>
      </div>

      <div id="mobile-nav" class="mobile-nav hidden">
        <div class="mt-3 mb-5 mobile-nav__link-container">
          <a
            href="https://clangen.io/docs/"
            class="small_download_btn"
            target="_blank"
            rel="noreferrer">Documentation</a
          >
        </div>
        <div class="mb-5 mobile-nav__link-container">
          {
            linkToDevelopment ? (
              <a
                href={downloadBaseUrl + "/download-development"}
                class="small_download_btn whitespace-nowrap"
              >
                Download development
              </a>
            ) : (
              <a
                href={downloadBaseUrl + "/download"}
                class="small_download_btn"
              >
                Download
              </a>
            )
          }
        </div>
        <div class="mb-2 mobile-nav__link-container">
          <a href={discord_link_store} class="small_download_btn">Discord</a>
        </div>
      </div>
      <slot />
    </div>
  </body>
</html>

<script>
  import { getCurrentSeason } from "../lib/postlight/seasons";

  const mobileNavElement = document.getElementById("mobile-nav");
  const rootElement: HTMLElement | null = document.querySelector(":root");

  // mobile nav
  let navVisible = false;
  document
    .getElementById("hamburger-button")
    ?.addEventListener("click", (e) => {
      navVisible = !navVisible;
      if (navVisible) {
        mobileNavElement?.classList.add("block");
        mobileNavElement?.classList.remove("hidden");
      } else {
        mobileNavElement?.classList.remove("block");
        mobileNavElement?.classList.add("hidden");
      }
    });

  // background
  let campType = ["beach", "forest", "mountainous", "plains"][
    Math.floor(Math.random() * 4)
  ]; // random in list
  let campNumber = Math.floor(Math.random() * 3) + 1; // random 1-3

  const currentHumanSeason = getCurrentSeason(new Date());
  let season = "newleaf";
  if (currentHumanSeason === "spring") {
    season = "newleaf";
  } else if (currentHumanSeason === "summer") {
    season = "greenleaf";
  } else if (currentHumanSeason === "winter") {
    season = "leafbare";
  } else if (currentHumanSeason === "fall") {
    season = "leaffall";
  }

  rootElement?.style.setProperty(
    "--background-url",
    `url("/backgrounds/${campType}/${season}_camp${campNumber}_light.png")`,
  );
</script>

<style>
  @reference "tailwindcss";

  :global(body, html) {
    padding: 0;
    margin: 0;
    color: white;
    background-color: #302915;
  }

  :global(body) {
    background-image: var(--background-url);
    background-repeat: no-repeat;
    background-size: cover;
    background-attachment: fixed;
    image-rendering: pixelated;
    min-height: 100vh;
    height: fit-content;
    display: flex;
  }

  .container_internal {
    display: flex;
    flex-direction: column;
    backdrop-filter: blur(8px);
    width: 100%;
    flex-grow: 1;
  }

  .navbar {
    background-color: #302915;
    box-shadow: 0px 4px 4px 0px rgba(0, 0, 0, 0.25);
    @apply px-1 lg:px-2 py-2;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    box-sizing: content-box;
  }
  .navbar__title {
    display: flex;
    align-items: center;
    @apply h-fit;
  }
  .navbar__title h1 {
    @apply text-xl;
    font-family: var(--font-clangen), sans-serif;
    color: #f1e5cb;
    text-shadow: 0px 4px 4px rgba(0, 0, 0, 0.25);
    font-weight: 700;
  }
  .navbar__title img {
    @apply h-9 w-auto mr-2;
  }
  .navbar__links {
    @apply hidden gap-2 ml-auto sm:flex;
  }
  .navbar__hamburger {
    @apply pt-2 pr-2 ml-auto sm:hidden;
  }

  .navbar a {
    text-decoration: none;
    display: flex;
  }

  .mobile-nav {
    @apply border-r-8 border-[#7e6041] py-2 sm:hidden;
  }
  .mobile-nav__link-container {
    width: fit-content;
    @apply ml-auto;
  }

  .small_download_btn {
    padding: 7px;
    background: #67582e;
    border: 4px solid #7e6041;
    box-shadow:
      0px 1px 3px 0px rgba(0, 0, 0, 0.12) inset,
      0px 1px 2px 0px rgba(0, 0, 0, 0.24) inset;
  }

  .small_download_btn,
  .small_download_btn:link,
  .small_download_btn:visited,
  .small_download_btn:active {
    color: #f1e5cb;
    font-family: var(--font-clangen), sans-serif;
    text-decoration: none;
  }
</style>

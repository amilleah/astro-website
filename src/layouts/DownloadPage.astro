---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import "../styles/platform-box.css";

const { linkToDevelopment } = Astro.props;
---

<Layout title="ClanGen Download" linkToDevelopment={linkToDevelopment}>
  <div class="wrapper">
    <Header />

    <div class="extension">
      <div class="content">
        <slot />
        <div class="downloadBoxes">
          <slot name="download-boxes" />
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  @reference "tailwindcss";

  .wrapper {
    max-width: 700px;
    margin: 0 auto;
  }

  .extension {
    box-sizing: border-box;
    background-color: #2f2918;

    @apply border-[#826657] border-[0.2vw] lg:border-[1.5px];
    border-top: none;
    border-radius: 0 0 8px 8px;

    padding: 20px 0;
    margin-bottom: 100px;
    box-shadow:
      0px 10px 10px 0px rgba(0, 0, 0, 0.22),
      0px 4px 4px 0px rgba(0, 0, 0, 0.25);
  }

  .content {
    @apply w-[90%] lg:w-fit;
    margin: auto;
  }

  .content :global(h2) {
    font-weight: bold;
    margin-bottom: 1em;
  }

  .content :global(.section-box) {
    color: white;
    text-align: center;
    background-color: #313537;
    @apply w-full rounded-md border border-[#3D4144] p-5 my-2.5;
  }

  .downloadBoxes {
    font-family: var(--font-roboto);
    display: flex;
    gap: 8px;
    @apply flex-col lg:flex-row;
    margin: auto;
  }
</style>

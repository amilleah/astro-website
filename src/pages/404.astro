---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Button from "../components/Button.astro";

import headerBlank from "../assets/header_blank.png";
import confusedCat from "../assets/gen_bord_newmed1_Ln.png";
---

<Layout title="404: Page not found">
  <div class="wrapper">
    <Header image={headerBlank} alt="">
      <div class="kitty" slot="overlay">
        <Image src={confusedCat} alt="A confused cat" />
      </div>

      <h2 class="title">404: Page not found</h2>
      <h3 class="subtitle">Have you asked StarClan where this page went?</h3>

      <Button href="/" size="lg">Return Home</Button>
    </Header>
  </div>
</Layout>

<style>
  .wrapper {
    width: var(--content-width);
    margin: 0 auto;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    padding-bottom: calc(var(--space) * 2);
  }

  .title {
    margin: 0;
    color: var(--color-text);
    font-family: var(--font-clangen), sans-serif;
    font-size: var(--pixel-xl);
    line-height: normal;
    font-weight: 400;
    text-align: center;
    text-shadow: var(--shadow-text);
  }

  .subtitle {
    margin: 0;
    color: var(--color-heading);
    font-family: var(--font-clangen), sans-serif;
    font-size: var(--text-md);
    line-height: 1;
    font-weight: 500;
    text-align: center;
  }

  .kitty {
    position: absolute;
    left: 50%;
    bottom: 0;
    z-index: var(--z-top);
    transform: translateX(-55%);
    line-height: 0;
  }

  .kitty :global(img) {
    display: block;
    width: clamp(14rem, 42vw, 23rem);
    height: auto;
    image-rendering: pixelated;
  }
</style>

---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Frame from "../components/Frame.astro";
import Button from "../components/Button.astro";
import Screenshots from "../components/Screenshots.astro";
import { Icon } from "astro-icon/components";
---

<Layout>
  <div class="wrapper">
    <Header title="ClanGen" subtitle="Build your Clan. Tell their story.">
      <Button slot="action" href="/download" size="lg">Download Now</Button>
    </Header>

    <Frame class="info">
      <h2>Every cat has their own story</h2>

      <p>
        ClanGen is a casual simulation game with a focus on storytelling.
        <br /><br />

        Build a Clan of cats, then watch it change over time. Influence their
        strategies and relationships, or simply watch the narratives unfold.
        <br /><br />

        With <b>millions</b> of unique cat appearances and <b>hundreds</b> of events
        to discover, the possibilities are endless.
        <br /><br />
      </p>
    </Frame>

    <Frame class="info">
      <h2>Free and Open Source</h2>

      <p>
        Originally created by just-some-cat on Tumblr, ClanGen was forked by
        Sablesteel and is now steadily updated and maintained by an ever-growing
        community of volunteers from all over the world.
      </p>

      <div class="gh-slot">
        <Button
          href="https://github.com/ClanGenOfficial/clangen"
          target="_blank"
          rel="noreferrer"
          size="md"
        >
          View on GitHub <Icon name="fa7-brands:github" />
        </Button>
      </div>
    </Frame>

    <Screenshots class="info" />
  </div>
</Layout>

<style>
  .wrapper {
    width: var(--content-width);
    margin: 0 auto;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: var(--space);
    padding-top: var(--space);
    padding-bottom: calc(var(--space) * 2);
  }

  :global(.info),
  :global(.header-frame .content) {
    font-family: var(--font-roboto), sans-serif;
    align-items: flex-start;
    justify-content: flex-start;
    text-align: left;
    transition: filter 0.15s ease;
  }

  :global(.info):hover {
    filter: brightness(1.03);
  }

  :global(.info) h2 {
    margin: 0;
    padding-bottom: var(--space-2xs);
    border-bottom: var(--border-thin) solid
      color-mix(in srgb, var(--color-heading) 35%, transparent);
    color: var(--color-heading);
    font-family: var(--font-clangen), sans-serif;
    font-size: var(--text-xl);
    line-height: 1.35;
    font-weight: 500;
  }

  :global(.info) p {
    margin: 0;
    color: var(--color-text);
    font-size: var(--text-lead);
    line-height: 1.35;
  }

  :global(.info) a:not(.btn) {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  :global(.info) a:not(.btn):hover {
    color: var(--color-download-hover);
  }

  .gh-slot {
    align-self: center;
  }
</style>

---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Tab from "../components/Tab.astro";
import Button from "../components/Button.astro";
import Downloads from "../components/Downloads.astro";
import { Icon } from "astro-icon/components";
---

<Layout title="ClanGen Download">
  <div class="wrapper">
    <Header>
      <h2 class="title">Download</h2>

      <div class="tabpanel">
        <div class="tabbar">
          <div class="tabgroup">
            <Tab data-tab="stable" href="#stable" active>Stable</Tab>
            <Tab data-tab="development" href="#development">Development</Tab>
          </div>
          <Button
            href="https://github.com/ClanGenOfficial/clangen"
            target="_blank"
            rel="noreferrer"
            size="md"
            class="gh-cta"
          >
            View on GitHub <Icon name="fa7-brands:github" />
          </Button>
        </div>

        <div class="panegrid">
          <div data-pane="stable" class="pane">
            <Downloads channel="stable" label="Latest stable version" />
          </div>
          <div data-pane="development" class="pane" hidden>
            <Downloads
              channel="development"
              label="Latest development version"
            />
          </div>
        </div>
      </div>
    </Header>
  </div>
</Layout>

<script is:inline>
  const tabs = Array.from(document.querySelectorAll("[data-tab]"));
  const panes = Array.from(document.querySelectorAll("[data-pane]"));
  const names = tabs.map((tab) => tab.getAttribute("data-tab"));

  function activate(name) {
    const active = names.includes(name) ? name : names[0];
    tabs.forEach((tab) => {
      const on = tab.getAttribute("data-tab") === active;
      tab.classList.toggle("tab--active", on);
      tab.setAttribute("aria-selected", on ? "true" : "false");
    });
    panes.forEach((pane) => {
      pane.hidden = pane.getAttribute("data-pane") !== active;
    });
  }

  activate(location.hash.slice(1));
  window.addEventListener("hashchange", () => activate(location.hash.slice(1)));
</script>

<style>
  .wrapper {
    width: var(--content-width);
    margin: 0 auto;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    padding-bottom: calc(var(--space) * 2);
  }

  .title {
    margin: 0;
    color: var(--color-text);
    font-family: var(--font-clangen), sans-serif;
    font-size: var(--pixel-xl);
    line-height: normal;
    font-weight: 400;
    text-align: center;
    text-shadow: var(--shadow-text);
  }

  .tabpanel {
    --divider: var(--border-divider);
    --pad: var(--space);
    width: 100%;
    display: flex;
    flex-direction: column;
    text-align: left;
  }

  .tabbar {
    position: relative;
    z-index: var(--z-raised);
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    width: 100%;
  }

  .tabgroup {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    flex-wrap: wrap;
    gap: 0;
    margin-bottom: 0;
  }

  .tabbar :is(a, button).btn.gh-cta {
    margin-bottom: var(--space-3xs);
  }

  .panegrid {
    position: relative;
    z-index: var(--z-base);
    box-sizing: border-box;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    width: calc(100% + 2 * var(--pad));
    margin-inline: calc(-1 * var(--pad));
    padding: var(--space) var(--pad) 0;
    border-top: var(--divider) solid var(--color-border);
  }

  .pane {
    grid-area: 1 / 1;
    width: 100%;
    min-width: 0;
  }

  .pane[hidden] {
    display: block;
    visibility: hidden;
  }
</style>
